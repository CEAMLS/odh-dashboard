ODH_IS_PROJECT_ROOT_DIR=false
ODH_PORT=${FRONTEND_PORT}

########## Change the following three variables for ODH/OpenShift AI ##########
# CEAMLS: branded as "CEAMLS Data Hub" with the console's logos
# (ceamls_ai_cluster branding/, copied into src/images).
ODH_LOGO=ceamls-logo.png
ODH_LOGO_DARK=ceamls-logo-dark.png
ODH_PRODUCT_NAME=CEAMLS Data Hub
ODH_FAVICON=ceamls-favicon.png
ODH_NOTEBOOK_REPO=opendatahub

########## CEAMLS: single logout ##########
# "Log out" calls /oauth/sign_out, which only drops this app's oauth-proxy
# cookie — the Keycloak SSO session (idle 10h) survives, so the next login
# needs no password. Send the browser on to Keycloak's RP-initiated logout
# endpoint afterwards. client_id is the realm client the OpenShift OAuth
# server logs in through, and the post_logout_redirect_uri below must be
# listed on that client (ceamls_ai_cluster gitops/keycloak/60-realm.yaml).
# Empty = stock behaviour (reload after sign-out).
ODH_SSO_LOGOUT_URL=https://keycloak.apps.ceamls.morgan.edu/realms/ceamls/protocol/openid-connect/logout?client_id=openshift&post_logout_redirect_uri=https%3A%2F%2Fodh-dashboard-opendatahub.apps.ceamls.morgan.edu%2F

########## Change this version with each dashboard release ###########
INTERNAL_DASHBOARD_VERSION=v2.38.1
