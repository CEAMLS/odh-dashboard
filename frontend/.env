ODH_IS_PROJECT_ROOT_DIR=false
ODH_PORT=${FRONTEND_PORT}

########## Change the following three variables for ODH/OpenShift AI ##########
# CEAMLS: branded as "CEAMLS Data Hub" with the console's logos
# (ceamls_ai_cluster branding/, copied into src/images).
ODH_LOGO=ceamls-logo.png
ODH_LOGO_DARK=ceamls-logo-dark.png
ODH_PRODUCT_NAME=CEAMLS Data Hub
ODH_FAVICON=ceamls-favicon.png
ODH_NOTEBOOK_REPO=opendatahub

########## CEAMLS: single logout ##########
# "Log out" starts the CEAMLS single-logout chain here instead of calling
# /oauth/sign_out. The page revokes every OpenShift token the user holds —
# this app's and the console's — drops this app's oauth-proxy cookie, ends the
# OAuth server's own session, and only then ends the Keycloak SSO session, so
# signing out of one app signs them out of all of them. Order matters both
# ways: every hop needs the session before it to get in, and Keycloak goes
# last because a live SSO session would sign the user straight back in.
# The console's logoutRedirect points at this same URL, and the path rides
# oauth-proxy's one unauthenticated prefix on purpose — see the route
# (backend/src/routes/metrics-logout/index.ts).
# Empty = stock behaviour (sign out of this app only, then reload).
ODH_SSO_LOGOUT_URL=/metrics-logout

########## Change this version with each dashboard release ###########
INTERNAL_DASHBOARD_VERSION=v2.38.1
