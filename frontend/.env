ODH_IS_PROJECT_ROOT_DIR=false
ODH_PORT=${FRONTEND_PORT}

########## Change the following three variables for ODH/OpenShift AI ##########
# CEAMLS: branded as "CEAMLS Data Hub" with the console's logos
# (ceamls_ai_cluster branding/, copied into src/images).
ODH_LOGO=ceamls-logo.png
ODH_LOGO_DARK=ceamls-logo-dark.png
ODH_PRODUCT_NAME=CEAMLS Data Hub
ODH_FAVICON=ceamls-favicon.png
ODH_NOTEBOOK_REPO=opendatahub

########## CEAMLS: single logout ##########
# "Log out" starts the logout chain here instead of calling /oauth/sign_out:
# Keycloak's RP-initiated logout ends the SSO session (idle 10h) and comes
# back to /api/ceamls-logout, which revokes every OpenShift token the user
# holds — this app's and the console's — drops this app's oauth-proxy cookie
# and ends the OAuth server's own session. Signing out of one app therefore
# signs them out of all of them. Order matters: the SSO session has to die
# first, or the last hop would sign the user straight back in.
# client_id is the realm client the OpenShift OAuth server logs in through,
# and the post_logout_redirect_uri below must be listed on that client
# (ceamls_ai_cluster gitops/keycloak/60-realm.yaml).
# Empty = stock behaviour (sign out of this app only, then reload).
ODH_SSO_LOGOUT_URL=/api/ceamls-logout

########## Change this version with each dashboard release ###########
INTERNAL_DASHBOARD_VERSION=v2.38.1
